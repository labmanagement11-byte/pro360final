NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Avisos con la app cerrada (opcional, no inventar la clave).
# Generar en la computadora: npx web-push generate-vapid-keys
# Solo la pública va en .env.local y, al publicar, en Vercel.
# La privada no se sube al sitio ni a este archivo.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#
# La función supabase/functions/work-push lee estos secretos en Supabase
# (no van en el repositorio):
# VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT=mailto:avisos@360pro.com
# WORK_PUSH_SECRET
